{
  "name": "nail-salon-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test \"tests/*.test.ts\"",
    "test:db": "node --test \"tests/db/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma migrate dev --name init && prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
