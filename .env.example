# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://salon:salon_dev_password@localhost:5432/salon?schema=public"
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
# Used to sign cookies/CSRF. Generate the same way.
SESSION_SECRET=""
APP_URL="http://localhost:3000"
SALON_TIMEZONE="Asia/Tehran"
# Seed: first Owner account (used only by `npm run db:seed`)
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""        # >= 10 chars, letters + digits
# SMS: leave unset to use the mock provider (logs to NotificationLog, sends nothing)
SMS_PROVIDER="mock"
# SMS_API_KEY=""   # needed only after you add a real Iranian provider adapter
# Private receipt storage (local folder in development)
RECEIPT_STORAGE_DIR="./storage/receipts"
